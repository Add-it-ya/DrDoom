# Copy to .env and fill in. .env is gitignored; never commit it.

# local | ci | production
DRDOOM_ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR
DRDOOM_LOG_LEVEL=INFO

# Free tier, no card: https://console.groq.com
GROQ_API_KEY=

# Optional, needs: uv sync --extra anthropic
# ANTHROPIC_API_KEY=

# Optional: a different model to review the risk of each plan. Unset, the same model
# reviews it in a separate call that never sees the plan author's own rating.
# DRDOOM_RISK_PROVIDER=groq
# DRDOOM_RISK_MODEL=

# What triage scores windows with: conv (default), conv+naive, or window_spread.
# DRDOOM_DETECTOR=conv

# Finished investigations older than this many days are deleted at start-up; 0 keeps
# them all. Incidents awaiting a decision and the audit log are never pruned.
# DRDOOM_RETENTION_DAYS=30

# Investigations one caller may start per minute (its API key if it sends one, else its
# address), and all callers together. 0 lifts a limit; beyond it the answer is 429.
# DRDOOM_INVESTIGATE_PER_MINUTE=10
# DRDOOM_INVESTIGATE_PER_MINUTE_TOTAL=60

# name:key pairs, comma separated. Required to approve a remediation and to read
# stored incidents. Add :YYYY-MM-DD to a pair to stop that key working from that day (UTC).
DRDOOM_API_KEYS=aditya:change-me
